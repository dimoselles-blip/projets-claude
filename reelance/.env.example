# ═══════════════════════════════════════════════════════════════
#  Reelance — variables d'environnement
#  Copiez ce fichier en .env et remplissez les valeurs.
#  Ne commitez JAMAIS le fichier .env (il contient vos clés secrètes).
# ═══════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────
# URL publique du site, sans « / » final (sert aux liens des e-mails et au retour de paiement FedaPay)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Base de données PostgreSQL ─────────────────────────────────
# Local : postgresql://utilisateur:motdepasse@localhost:5432/reelance?schema=public
# Neon / Supabase / Railway : collez l'URL de connexion fournie (ajoutez ?sslmode=require si demandé)
DATABASE_URL="postgresql://reelance:reelance@localhost:5432/reelance?schema=public"

# Durée de validité d'une session de connexion (jours)
SESSION_MAX_AGE_DAYS=30

# ── Compte administrateur (créé par « npm run db:seed ») ────────
ADMIN_EMAIL="admin@votre-domaine.com"
ADMIN_PASSWORD="changez-moi-maintenant"
ADMIN_NAME="DIMO"

# ── FedaPay ─────────────────────────────────────────────────────
# Mode : déduit automatiquement de la clé secrète (sk_live_… → live, sk_sandbox_… → sandbox).
# Ne décommentez que pour forcer un mode.
# FEDAPAY_ENV="sandbox"
# Clés API : tableau de bord FedaPay → Paramètres → Clés API
#   sandbox : pk_sandbox_… / sk_sandbox_…    live : pk_live_… / sk_live_…
FEDAPAY_PUBLIC_KEY="pk_sandbox_xxxxxxxxxxxxxxxxxxxx"
FEDAPAY_SECRET_KEY="sk_sandbox_xxxxxxxxxxxxxxxxxxxx"
# Secret du webhook : tableau de bord FedaPay → Webhooks → créer un webhook vers
#   https://votre-domaine/api/webhooks/fedapay  puis copier la clé « wh_… »
FEDAPAY_WEBHOOK_SECRET="wh_sandbox_xxxxxxxxxxxxxxxxxxxx"
# (Optionnel) forcer une autre URL d'API
# FEDAPAY_API_BASE="https://sandbox-api.fedapay.com"

# Mode démo : simule paiements et reversements SANS clés FedaPay (développement uniquement).
# Ignoré automatiquement en mode live (clé sk_live_…).
PAYMENT_SIMULATION=false

# ── Tâches planifiées ──────────────────────────────────────────
# Secret partagé pour appeler GET /api/cron (validation automatique des livraisons + taux de change)
# Générez-le avec : openssl rand -hex 32
CRON_SECRET=""

# ── Cloudinary (photos de profil, couvertures, logos) ──────────
# cloudinary.com → Dashboard → API Keys. Sans ces valeurs, les utilisateurs collent un lien d'image.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="reelance"

# ── E-mails transactionnels (SMTP) ─────────────────────────────
# Hostinger : smtp.hostinger.com, port 465, SMTP_SECURE=true, identifiants de la boîte mail
# Sans SMTP_HOST, les e-mails sont simplement affichés dans les logs du serveur.
SMTP_HOST=""
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Reelance <no-reply@votre-domaine.com>"

# ── Taux de change ──────────────────────────────────────────────
# API gratuite sans clé (base XOF). EUR et XAF utilisent la parité fixe (1 € = 655,957 FCFA).
EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest/XOF"
EXCHANGE_RATE_TTL_HOURS=12
